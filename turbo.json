{
    "$schema": "https://turborepo.org/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "typecheck": {},
        "deploy": {
            "dependsOn": [
                "build"
            ],
            "cache": false
        },
        "env:push": {
            "cache": false
        }
    }
}